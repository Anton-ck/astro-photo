---
import { Image } from 'astro:assets';
import about from '/src/assets/about/about.webp';
import AboutContent from '../content/about.md';
---

<section id="about" class="container mx-auto flex-initial px-4 py-10 md:py-16">
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-6 md:flex-row md:items-start md:gap-10"
  >
    <Image
      src={about}
      alt="Yulia Kovalenko Cherkassy"
      fetchpriority="high"
      class="h-auto w-full rounded-xl object-cover object-center md:w-[45%] lg:w-[40%]"
      width={470}
    />
    <div class="w-full md:flex-1">
      <h2 class="font-antonio text-2xl text-black md:text-3xl lg:text-4xl pb-5">
        The photographer Yulia Kovalenko
      </h2>
      <div
        class="prose prose-neutral mt-4 max-w-prose text-base leading-7 md:leading-8"
      >
        <AboutContent />
      </div>
    </div>
  </div>
</section>
